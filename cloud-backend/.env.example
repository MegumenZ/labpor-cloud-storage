# Environment variables template for Labpro Storage Cloud Backend
# Copy this file to .env, replace every placeholder, and keep .env out of version control.

# PostgreSQL (use the password configured for your local database role)
DATABASE_URL=postgres://postgres:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/skripsi_cloud

# Generate a unique secret, for example: openssl rand -base64 48
# Must be at least 32 characters and must not be a public/example value.
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET

# Explicit frontend origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Runtime environment: development or production
NODE_ENV=development

# Ceph RGW S3 Storage
S3_ENDPOINT=http://192.168.100.53:8000
S3_ACCESS_KEY_ID=REPLACE_WITH_CEPH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_CEPH_SECRET_KEY
S3_BUCKET_NAME=labpro-storage
S3_REGION=us-east-1

# Ceph Manager Prometheus metrics URL
CEPH_PROM_URL=http://192.168.100.53:9283/metrics

# Optional global logical storage quota in bytes. If unset, the backend uses Ceph's reported capacity.
# Set this to an effective/usable capacity value when raw cluster capacity should not be exposed as quota.
# STORAGE_QUOTA_BYTES=<effective-capacity-in-bytes>

# OpenSearch credentials.
# Use a strong, unique password and keep it synchronized with Fluent Bit.
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_OPENSEARCH_PASSWORD
